# ==============================================================================
# Configuracoes do Sistema - Agente de Compras
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=compras
DATABASE_URL=postgresql://admin:admin@postgres:5432/compras

# Servidor MCP (Model Context Protocol)
MCP_SERVER_URL=http://mcp-server:8001
DUMMYJSON_BASE_URL=https://dummyjson.com
HTTP_TIMEOUT=15.0

# OpenRouter LLM
# Insira sua chave da OpenRouter abaixo:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
